<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="environment">
  
    <link name="abb_table">
      <inertial>
        <origin xyz="0.3325 0 -0.561085" rpy="0 0 0" />
        <mass value="580.907" />
        <inertia ixx="80.377" ixy="0" ixz="0" iyy="114.089" iyz="0" izz="100.823" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find assembly_environment)/meshes/abb_table.STL" />
        </geometry>
        <material name="">
          <color rgba="0.792 0.820 0.933 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find assembly_environment)/meshes/abb_table.STL" />
        </geometry>
      </collision>
    </link>

    <link name="ar4_table">
      <inertial>
        <origin xyz="-0.429355 0 -0.466079" rpy="0 0 0" />
        <mass value="173.611" />
        <inertia ixx="40.833" ixy="0" ixz="-0.418" iyy="53.233" iyz="0" izz="33.728" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find assembly_environment)/meshes/ar4_table.STL" />
        </geometry>
        <material name="">
          <color rgba="0.792 0.820 0.933 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find assembly_environment)/meshes/ar4_table.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="ar4_frame" type="fixed">
      <origin xyz="1.11 0 0.0065" rpy="0 0 3.14159265358979" />
      <parent link="abb_table" />
      <child link="ar4_table" />
    </joint>

    <link name="camera">
      <inertial>
        <origin xyz="-0.015 0.115 -0.038" rpy="0 0 0" />
        <mass value="0.069517" />
        <inertia ixx="0.000369" ixy="0" ixz="0" iyy="1.347E-05" iyz="0" izz="0.000369" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find assembly_environment)/meshes/camera.STL" />
        </geometry>
        <material name="">
          <color rgba="0.792 0.820 0.933 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find assembly_environment)/meshes/camera.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="camera_frame" type="fixed">
      <origin xyz="0.67 0.01 0.8035" rpy="3.14159265358979 0 1.57079632679489" />
      <parent link="abb_table" />
      <child link="camera" />
    </joint>
    <link name="camera_link">
      <inertial>
        <mass value="0.001" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>

    <!-- <joint name="camera_optical_joint" type="fixed">
      <origin xyz="0 0 0.025" rpy="3.14 -1.57 -1.57" />
      <parent link="camera" />
      <child link="camera_link" />
    </joint> -->

  <!-- # brick.pose.position.x = brick.pose.position.x - 0.0546
                # brick.pose.position.y = brick.pose.position.y + 0.674
                # brick.pose.position.z = 0.769-brick.pose.position.z -->
    <joint name="camera_color_optical_frame" type="fixed">
      <origin xyz="0.674 -0.0546 0.769" rpy="3.14 1.57 0.0" />
      <parent link="abb_table" />
      <child link="camera_link" />
    </joint>

    </xacro:macro>
</robot>